# BILL MCP server configuration. Pass these to the MCP server process (e.g. in your client's "env" block).

# sandbox (gateway.stage.bill.com) or production (gateway.prod.bill.com)
BILL_ENVIRONMENT=sandbox

# Core API credentials (required)
BILL_USERNAME=
BILL_PASSWORD=
BILL_ORGANIZATION_ID=
BILL_DEV_KEY=

# MFA: set after running bill_mfa_validate_challenge with rememberMe=true so sessions are MFA-trusted
BILL_REMEMBER_ME_ID=
BILL_DEVICE_NAME=bill-mcp

# Spend & Expense API token (optional; enables the spend toolset)
BILL_SPEND_API_TOKEN=

# Safety switches
BILL_READ_ONLY=false
BILL_ENABLE_MONEY_MOVEMENT=false

# Optional tuning
# BILL_TOOLSETS=all
# BILL_UPLOAD_ROOT=/path/to/invoices
# BILL_MAX_CONCURRENCY=3
# BILL_MAX_RETRIES=4
# BILL_TIMEOUT_MS=60000
# BILL_SESSION_IDLE_MINUTES=30
# BILL_MAX_FETCH_ALL=2000
# BILL_MAX_RESPONSE_CHARS=100000
# BILL_LOG_LEVEL=info
